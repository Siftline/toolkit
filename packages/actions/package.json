{
  "name": "@siftline/actions",
  "version": "0.1.1",
  "description": "Siftline adapters for the places labels land: issue trackers, inboxes and queues.",
  "keywords": [
    "actions",
    "classification",
    "siftline",
    "triage"
  ],
  "homepage": "https://docs.siftline.dev",
  "bugs": {
    "url": "https://github.com/Siftline/toolkit/issues"
  },
  "license": "MIT",
  "author": "Todayweb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siftline/toolkit.git",
    "directory": "packages/actions"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@siftline/core": "^0.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@siftline/config": "workspace:*",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.14"
  },
  "//zod": "Direct, though core already depends on it: `Adapter<C>.configSchema` is a `ZodType<C>`, so zod is in this package's public types and must resolve from here. The spec's \"actions adds none beyond core\" is owed a correction."
}
