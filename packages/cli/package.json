{
  "name": "@siftline/cli",
  "version": "0.0.2",
  "description": "The Siftline command line: measure a recipe against its fixtures, then label for real.",
  "keywords": [
    "classification",
    "cli",
    "siftline",
    "triage"
  ],
  "homepage": "https://docs.siftline.dev",
  "bugs": {
    "url": "https://github.com/Siftline/toolkit/issues"
  },
  "license": "MIT",
  "author": "Todayweb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siftline/toolkit.git",
    "directory": "packages/cli"
  },
  "bin": {
    "siftline": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@siftline/core": "^0.0.3",
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@siftline/config": "workspace:*",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.14"
  }
}
