{
  "extends": "@siftline/config/library.json",
  "compilerOptions": {
    // Maps the published name back at source so `typecheck` never waits on `build`. The
    // colocated tests import by that name to prove the `exports` map (ADR 0004).
    "paths": {
      "@siftline/cli": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tsdown.config.ts", "vitest.config.ts"]
}
