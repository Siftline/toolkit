{
  "name": "@siftline/core",
  "version": "0.2.0",
  "description": "The Siftline engine: recipes, rules, fixtures and the judge wrapper.",
  "keywords": [
    "classification",
    "siftline",
    "triage"
  ],
  "homepage": "https://docs.siftline.dev",
  "bugs": {
    "url": "https://github.com/Siftline/toolkit/issues"
  },
  "license": "MIT",
  "author": "Todayweb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siftline/toolkit.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint": "vp lint --type-aware --deny-warnings",
    "lint:fix": "vp lint --type-aware --deny-warnings --fix",
    "test": "vp test run",
    "test:live": "vp test run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@siftline/config": "workspace:*",
    "@typesafe-ai/sdk": "0.6.0",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.14"
  }
}
