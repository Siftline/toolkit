{
  "extends": "@siftline/config/library.json",
  "compilerOptions": {
    // The colocated tests import this package by its published name, which proves the
    // `exports` map from a consumer's side when Vitest runs them against `dist`. For
    // typechecking we point those names back at source, so `typecheck` never waits on
    // `build` — the two stay siblings in the Turborepo graph (ADR 0004).
    "paths": {
      "@siftline/core": ["./src/index.ts"],
      "@siftline/core/testing": ["./src/testing.ts"]
    }
  },
  "include": ["src/**/*.ts", "tsdown.config.ts", "vitest.config.ts", "vitest.live.config.ts"]
}
