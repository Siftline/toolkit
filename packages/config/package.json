{
  "name": "@siftline/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared build config for this repo: tsconfig bases and the tsdown base for vp pack. Consumed just-in-time, never published.",
  "files": [
    "base.json",
    "library.json",
    "app.json",
    "tsdown.ts"
  ],
  "type": "module",
  "exports": {
    "./base.json": "./base.json",
    "./library.json": "./library.json",
    "./app.json": "./app.json",
    "./tsdown": "./tsdown.ts"
  },
  "scripts": {
    "lint": "vp lint --type-aware --deny-warnings",
    "lint:fix": "vp lint --type-aware --deny-warnings --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  }
}
