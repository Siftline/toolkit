{
  "name": "@siftline/toolkit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp run -r build && vp run -r lint && vp run -r typecheck && vp run -r test && vp run format:check",
    "dev": "vp run -r --parallel dev",
    "format": "vp fmt",
    "lint": "vp run -r lint",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck",
    "version-packages": "changeset version && vp fmt && pnpm install --lockfile-only",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "24.13.5",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "intent": {
    "skills": [
      "*"
    ]
  }
}
