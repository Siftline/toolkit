{
  "name": "@siftline/toolkit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run build lint typecheck test format:check",
    "dev": "turbo run dev",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "24.13.5",
    "publint": "0.3.24",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "intent": {
    "skills": [
      "*"
    ]
  }
}
