{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // `$TURBO_ROOT$` is absent from schema.json, so a typo here will not be flagged.
    "api": {
      "dependsOn": ["^build"],
      "inputs": [
        "typedoc.json",
        "tsconfig.typedoc.json",
        "typedoc-frontmatter.mjs",
        "api-entries/**",
        "$TURBO_ROOT$/packages/core/src/**",
        "$TURBO_ROOT$/packages/actions/src/**"
      ],
      "outputs": ["content/docs/api/**"]
    },
    // Restating `^build` is required: a package-level task replaces the root one rather
    // than merging with it.
    "build": {
      "dependsOn": ["^build", "api"],
      "outputs": [".output/**", ".tanstack/**", ".source/**"]
    },
    "test": {
      "dependsOn": ["^build", "build"]
    }
  }
}
