# Nothing else is implicitly safe: only this file, `_headers` and `_redirects` are
# excluded from upload by default, and wrangler prints no warning when it uploads a
# secret. `assert-no-secret-assets.sh` and `static-output.test.ts` read this same file.
.dev.vars
.dev.vars.*
.env
.env.*
wrangler.json
wrangler.jsonc
wrangler.toml
