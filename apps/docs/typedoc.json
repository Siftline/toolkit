{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",

  "entryPoints": ["api-entries/core.ts", "api-entries/core-testing.ts", "api-entries/actions.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "tsconfig.typedoc.json",

  "plugin": ["typedoc-plugin-markdown", "./typedoc-frontmatter.mjs"],
  "out": "content/docs/api",

  "outputFileStrategy": "members",
  "fileExtension": ".mdx",
  "entryFileName": "index.mdx",
  "modulesFileName": "index",

  "readme": "none",
  "githubPages": false,
  "disableSources": true,
  "excludeInternal": true,
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "hidePageTitle": true,
  "sanitizeComments": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table"
}
